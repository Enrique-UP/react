<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>URL Shortener</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <h1>URL Shortener</h1>

    <form action="/" method="post">
        <label for="url">Enter URL:</label><br>
        <input type="url" name="url" id="url" required /><br><br>

        <label for="shortCode">Enter Short Code:</label><br>
        <input type="text" name="shortCode" id="shortCode" /><br>
        <span>Same short code will not be submitted.</span><br><br>

        <button type="submit">Shorten</button>
    </form>

    <h2>Shortened URLs</h2>
    <ul>
        <% for (let [shortCode, url] of Object.entries(links)) { %>
            <li>
                <a href="/<%= shortCode %>" target="_blank"><%= host %>/<%= shortCode %></a> - <%= url %>
            </li>
        <% } %>
    </ul>
</body>
</html>